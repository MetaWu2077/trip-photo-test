# 腾讯云 COS 配置示例
# 复制此文件为 .env 并填入真实值（不要提交 .env 到版本控制！）

# 腾讯云账号 AppID（数字）
COS_APP_ID=1234567890

# CAM 密钥 SecretId
COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# CAM 密钥 SecretKey
COS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# COS 存储桶所在地域，例如 ap-guangzhou
COS_REGION=ap-guangzhou

# 存储桶名称（格式：<BucketName>-<AppID>）
COS_BUCKET=my-bucket-1234567890

# （可选）自定义 CDN 域名，例如 https://cdn.example.com
# 若留空，将使用默认 COS 域名：https://<bucket>.cos.<region>.myqcloud.com
COS_DOMAIN=
